[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

; The private profile overrides this inside the private paths via [includeIf] below.
[include]
  path = ~/.config/git/personal

[core]
  editor = zed --wait
  preloadindex = true
  fscache = true
  autocrlf = input
  trustctime = false
  ignorecase = false
  pager = delta

; Each file write to /mnt/d (drvfs/9p) on WSL is slow, and checkout writes files one at a
; time without workers; a 17.7k-file worktree checkout took several minutes.
[checkout]
  workers = 8
  thresholdForParallelism = 100

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[init]
  defaultBranch = main

[branch]
  autosetuprebase = always

[pull]
  rebase = true
  autostash = true

[push]
  default = current
  autoSetupRemote = true

[alias]
  ; `git profile <name>` copies the identity from ~/.config/git/<name> into the
  ; repo config and moves gh onto the same account.
  profile = "!f() { p=~/.config/git/$1; [ -f \"$p\" ] || { echo \"error: no profile at $p\" >&2; exit 1; }; for k in user.name user.email github.user; do git config \"$k\" \"$(git config --file \"$p\" \"$k\")\"; done; gh auth switch --user \"$(git config --file \"$p\" github.user)\" 2>/dev/null || echo 'warn: gh not authenticated; run `gh auth login`'; }; f"
  personal = profile personal
  private = profile private
  whoami = "!echo \"$(git config user.name) <$(git config user.email)>\""

[safe]
  directory = *

; Mode bits are not meaningful on the 9p mounts WSL uses for Windows drives.
[includeIf "gitdir:/mnt/"]
  [core]
    fileMode = false

[commit]
  gpgSign = false
[fetch]
  tags = true
  fsckObjects = false
  writeCommitGraph = true
[status]
  submoduleSummary = false
  showUntrackedFiles = normal
  aheadBehind = false
[feature]
  manyFiles = true
[remote "origin"]
  tagOpt = --force
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
[includeIf "gitdir:/mnt/d/repositories/private/"]
  path = ~/.config/git/private
[includeIf "gitdir/i:/mnt/e/poe/"]
  path = ~/.config/git/private
; The same paths as native Windows sees them.
[includeIf "gitdir/i:D:/repositories/private/"]
  path = ~/.config/git/private
[includeIf "gitdir/i:E:/poe/"]
  path = ~/.config/git/private

; Config hooks run before a repo's own pre-push hook, so repo hooks still run.
[hook "agent-push-guard"]
  event = pre-push
  command = ~/.config/git/hooks/agent-push-guard
