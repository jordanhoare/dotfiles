# local media only - no network, discovery, or telemetry
# macosx-* keys are ignored on linux

metadata-network-access=0
update-check=0
auto-preparse=0
http-proxy=
extraintf=

services-discovery=

medialibrary-scan-recursive=0
playlist-autostart=0
random=0
loop=0

macosx-recentitems-size=0
macosx-stats=0
macosx-continue-playback=0
macosx-autoplay=0
macosx-pause-minimized=1
macosx-video-autoresize=0
macosx-nativefullscreenmode=1

qt-privacy-ask=0
qt-recentplay=0

quiet=1
