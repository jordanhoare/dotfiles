{
  "error return": {
    "prefix": "iferr",
    "body": ["if err != nil {", "    return ${1:nil, }fmt.Errorf(\"${2:context}: %w\", err)", "}"],
    "description": "wrapped error return"
  },
  "test func": {
    "prefix": "tst",
    "body": ["func Test${1:Subject}_${2:Scenario}(t *testing.T) {", "    t.Parallel()", "    $0", "}"],
    "description": "parallel test function"
  },
  "table test": {
    "prefix": "tbl",
    "body": ["tests := []struct {", "    name string", "    ${1:in}   ${2:string}", "    want ${3:string}", "}{", "    {name: \"${4:case}\", ${1:in}: ${5:\"\"}, want: ${6:\"\"}},", "}", "for _, tt := range tests {", "    t.Run(tt.name, func(t *testing.T) {", "        $0", "    })", "}"],
    "description": "table-driven test"
  }
}
