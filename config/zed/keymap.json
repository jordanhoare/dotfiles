[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-o": "project_symbols::Toggle",
      "cmd-shift-d": "diagnostics::Deploy",
      "cmd-shift-r": "task::Spawn",
      "cmd-b": "project_panel::ToggleFocus",
      "cmd-shift-b": "workspace::ToggleLeftDock",
      "cmd-e": "tab_switcher::Toggle",
      "cmd-g": "git::Diff",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-k cmd-g": "git::Commit",
      "cmd-k cmd-b": "git::Branch",
      "cmd-k cmd-u": "git::ViewUnstagedChanges",
      "cmd-k cmd-t": "git::ViewStagedChanges",
      "cmd-k cmd-h": "git::ViewStash",
      "cmd-k cmd-w": "git::Worktree"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-s": "workspace::SaveWithoutFormat",
      "cmd-.": "editor::ToggleCodeActions",
      "f2": "editor::Rename",
      "f12": "editor::GoToDefinition",
      "shift-f12": "editor::FindAllReferences",
      "cmd-shift-i": "editor::Format",
      "cmd-k cmd-i": "editor::Hover",
      "f8": "editor::GoToDiagnostic",
      "shift-f8": "editor::GoToPreviousDiagnostic",
      "alt-down": "editor::GoToHunk",
      "alt-up": "editor::GoToPreviousHunk",
      "cmd-k cmd-r": "git::Restore",
      "cmd-shift-l": "editor::SelectAllMatches"
    }
  }
]
