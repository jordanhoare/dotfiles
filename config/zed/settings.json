{
  "theme": "Catppuccin Mocha",
  "icon_theme": "Catppuccin Mocha",
  "base_keymap": "VSCode",
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_size": 13,
  "ui_font_size": 13,
  "vim_mode": false,
  "session": {
    "trust_all_worktrees": true
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_view": "thread_history"
  },
  "tab_size": 2,
  "format_on_save": "on",
  "soft_wrap": "none",
  "show_whitespaces": "selection",
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "auto"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false,
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "nix": true,
    "html": false
  },
  "agent_servers": {
    "Claude Code": {
      "type": "custom",
      "command": "zsh",
      "args": ["-ic", "exec bunx @agentclientprotocol/claude-agent-acp@latest --acp"],
      "env": {}
    }
  },
  "load_direnv": "shell_hook",
  "terminal": {
    "shell": {
      "program": "zsh"
    },
    "font_family": "IosevkaTerm Nerd Font",
    "font_size": 13
  },
  "languages": {
    "Nix": {
      "language_servers": ["nil"]
    },
    "Markdown": {
      "format_on_save": "off"
    },
    "JSON": {
      "format_on_save": "off"
    }
  }
}
