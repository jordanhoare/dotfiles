{
  "theme": "Catppuccin Mocha (Blur)",
  "icon_theme": "Catppuccin Mocha",
  "window_background_appearance": "blurred",
  "experimental.theme_overrides": {
    "element.background": "#ffffff08",
    "element.hover": "#ffffff15",
    "element.active": "#ffffff20",
    "element.selected": "#ffffff15",
    "ghost_element.background": "#00000000",
    "ghost_element.hover": "#ffffff10",
    "ghost_element.active": "#ffffff18",
    "ghost_element.selected": "#ffffff12",
    "tab.active_background": "#ffffff10",
    "tab.inactive_background": "#00000000",
    "syntax": {
      "title": { "color": "#f38ba8", "font_weight": 700 },
      "emphasis": { "color": "#fab387", "font_style": "italic" },
      "emphasis.strong": { "color": "#f9e2af", "font_weight": 700 },
      "link_text": { "color": "#89b4fa", "font_style": "italic" },
      "link_uri": { "color": "#94e2d5" },
      "text.literal": { "color": "#a6e3a1" }
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_size": 13,
  "ui_font_size": 13,
  "vim_mode": false,
  "session": {
    "trust_all_worktrees": true
  },
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "default_width": 320,
    "status_style": "label_color",
    "sort_by_path": false,
    "collapse_untracked_diff": true
  },
  "tab_size": 2,
  "format_on_save": "on",
  "soft_wrap": "none",
  "show_whitespaces": "selection",
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "auto"
  },
  "inline_completions": {
    "disabled_globs": ["**"]
  },
  "features": {
    "edit_prediction_provider": "none"
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "show_commit_summary": true,
      "min_column": 80
    },
    "git_gutter": "tracked_files"
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "warning",
      "update_debounce_ms": 200
    },
    "include_warnings": true
  },
  "hover_popover_enabled": true,
  "hover_popover_delay": 250,
  "use_autoclose": true,
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_update": false,
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-blur": true,
    "catppuccin-icons": true,
    "nix": true,
    "toml": true,
    "lua": true,
    "make": true,
    "dockerfile": true,
    "basher": true,
    "hyprlang": true,
    "git-firefly": true,
    "marksman": true,
    "terraform": true,
    "html": false
  },
  "load_direnv": "shell_hook",
  "terminal": {
    "shell": {
      "program": "zsh"
    },
    "font_family": "IosevkaTerm Nerd Font",
    "font_size": 13
  },
  "languages": {
    "Nix": {
      "language_servers": ["nil"],
      "formatter": {
        "external": {
          "command": "nixfmt"
        }
      }
    },
    "Python": {
      "language_servers": ["ruff", "ty", "!pyright", "!pylsp"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        { "language_server": { "name": "ruff" } }
      ]
    },
    "Go": {
      "language_servers": ["gopls"],
      "format_on_save": "on",
      "tab_size": 4,
      "hard_tabs": true
    },
    "Lua": {
      "language_servers": ["lua-language-server"],
      "format_on_save": "on"
    },
    "TOML": {
      "language_servers": ["taplo"],
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "!typescript-language-server"],
      "format_on_save": "on"
    },
    "TSX": {
      "language_servers": ["vtsls", "!typescript-language-server"],
      "format_on_save": "on"
    },
    "JavaScript": {
      "language_servers": ["vtsls", "!typescript-language-server"],
      "format_on_save": "on"
    },
    "Shell Script": {
      "language_servers": ["bash-language-server"],
      "format_on_save": "on",
      "tab_size": 2
    },
    "Markdown": {
      "language_servers": ["marksman", "!markdown-oxide"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": [
            "--bun",
            "prettier",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "soft_wrap": "editor_width"
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": "prettier"
    }
  },
  "file_types": {
    "YAML": [
      ".pre-commit-config.yaml",
      ".pre-commit-hooks.yaml",
      ".markdownlint.yaml",
      ".secrets.baseline"
    ],
    "Shell Script": [".zshrc", ".zshenv", ".zprofile", ".zlogin", ".bashrc"],
    "HyprLang": ["hyprland.conf", "hyprpaper.conf", "hypridle.conf", "hyprlock.conf"]
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://json.schemastore.org/pre-commit-config.json": [
              ".pre-commit-config.yaml",
              ".pre-commit-config.yml"
            ],
            "https://json.schemastore.org/pre-commit-hooks.json": [
              ".pre-commit-hooks.yaml"
            ],
            "https://json.schemastore.org/markdownlint.json": [
              ".markdownlint.yaml",
              ".markdownlint.yml"
            ],
            "https://json.schemastore.org/github-workflow.json": [
              ".github/workflows/*.yml",
              ".github/workflows/*.yaml"
            ],
            "https://json.schemastore.org/github-action.json": [
              ".github/actions/*/action.yml",
              "action.yml"
            ]
          },
          "keyOrdering": false
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 100
        }
      }
    },
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true,
        "completeUnimported": true,
        "staticcheck": true,
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true
        }
      }
    }
  }
}
