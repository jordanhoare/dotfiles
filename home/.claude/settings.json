{
  "permissions": {
    "allow": [
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(git whoami:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/managed-globals-advisory.sh"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "outputStyle": "plain"
}
