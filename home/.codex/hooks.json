{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/block-dangerous-git.sh\"",
            "timeout": 10,
            "statusMessage": "Checking git command"
          }
        ]
      }
    ]
  }
}
