# Decrypted host entries. Include must precede every Host block, or ssh scopes it
# to the last one; a glob that matches nothing is not an error.
Include ~/.ssh/config.d/*

Host personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/personal
  IdentitiesOnly yes

Host private
  HostName github.com
  User git
  IdentityFile ~/.ssh/private
  IdentitiesOnly yes
