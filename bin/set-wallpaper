#!/usr/bin/env bash
# Apply the processed wallpaper as the desktop background on the current platform.
set -euo pipefail

WALLPAPER="${WALLPAPER:-$HOME/.config/wallpapers/wallpaper.jpg}"

if [[ ! -f "$WALLPAPER" ]]; then
  echo "wallpaper missing: $WALLPAPER (run \`make switch\` first)" >&2
  exit 1
fi

REAL="$(readlink -f "$WALLPAPER" 2>/dev/null || echo "$WALLPAPER")"

case "$(uname -s)" in
  Darwin)
    if ! command -v desktoppr >/dev/null 2>&1; then
      echo "desktoppr not found - run \`make switch\` first" >&2
      exit 1
    fi
    desktoppr "$REAL"
    ;;
  Linux)
    if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
      echo "WSL detected - set the Windows wallpaper through Windows settings" >&2
      exit 0
    fi
    if command -v gsettings >/dev/null 2>&1; then
      gsettings set org.gnome.desktop.background picture-uri "file://$REAL"
      gsettings set org.gnome.desktop.background picture-uri-dark "file://$REAL"
      gsettings set org.gnome.desktop.background picture-options "zoom"
    else
      echo "no supported desktop environment found (expected gsettings)" >&2
      exit 1
    fi
    ;;
  *)
    echo "unsupported platform: $(uname -s)" >&2
    exit 1
    ;;
esac

echo "wallpaper set: $REAL"
