#!/usr/bin/env bash
set -euo pipefail

: "${DOTFILES:?DOTFILES is not set - check ~/.zshenv}"
cd "$DOTFILES"

echo "==> nix"
nix flake update --flake ./nix
make switch

if command -v sheldon &>/dev/null; then
  echo "==> sheldon"
  sheldon lock --update
fi

if command -v mise &>/dev/null; then
  echo "==> mise"
  mise upgrade
fi

if command -v uv &>/dev/null; then
  echo "==> uv global tools"
  uv tool upgrade --all
fi

echo "==> done"
