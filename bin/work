#!/usr/bin/env bash
# open or attach a tmux dev session for the current project.
# layout: left pane = zsh at $PWD, right pane = claude code.

set -euo pipefail

session="$(basename "$PWD" | tr '. ' '__')"

# pre-accept claude code's workspace trust for this folder so the cli
# doesn't prompt on first launch. trust state lives in ~/.claude.json
# under projects.<absolute-path>.hasTrustDialogAccepted - this is an
# undocumented internal field, may break across major claude releases.
trust_file="$HOME/.claude.json"
if [ -f "$trust_file" ] && command -v jq >/dev/null; then
  tmp="$(mktemp)"
  jq --arg path "$PWD" \
    '.projects[$path] //= {} | .projects[$path].hasTrustDialogAccepted = true' \
    "$trust_file" > "$tmp" && mv "$tmp" "$trust_file"
fi

if ! tmux has-session -t "$session" 2>/dev/null; then
  tmux new-session -d -s "$session" -c "$PWD" -n code
  # IS_DEMO=1 strips org/email/banner chrome from the claude tui, freeing
  # rows for actual content. undocumented in public docs but referenced
  # in the binary as process.env.IS_DEMO.
  tmux split-window -h -t "$session:code" -c "$PWD" -e "IS_DEMO=1" claude
  tmux select-pane -t "$session:code" -L
fi

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$session"
else
  exec tmux attach-session -t "$session"
fi
