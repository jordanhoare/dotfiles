#!/usr/bin/env bash
# Assert every declared home.file Symlink for the given Home Manager
# configuration is in place under $HOME. Exits non-zero on the first miss.
#
# Usage: verify <flake-attribute>
set -eo pipefail

attr="${1:?usage: $(basename "$0") <flake-attribute>}"
flake="$(cd "$(dirname "$0")/../nix" && pwd)"

nix eval --impure --json "${flake}#${attr}" --apply 'fs: builtins.attrNames fs' \
  | jq -r '.[] | select(startswith("/") | not)
      | select(test("Home Manager Apps|/Fonts/|/\\.keep$") | not)' \
  | while IFS= read -r t; do
      [[ -L "$HOME/$t" ]] || { echo "missing: $HOME/$t" >&2; exit 1; }
    done
