#!/usr/bin/env bash
# Verbose local diagnostic: enumerates every declared Symlink, expected tool,
# and (when keys exist) git/ssh identity. Always exits 0 - this is a human
# diagnostic, not a gate. Use `verify` for the strict assertion.
#
# Usage: doctor <flake-attribute>
set -uo pipefail

attr="${1:?usage: $(basename "$0") <flake-attribute>}"
flake="$(cd "$(dirname "$0")/../nix" && pwd)"

echo "==> symlinks"
nix eval --impure --json "${flake}#${attr}" --apply 'fs: builtins.attrNames fs' 2>/dev/null \
  | jq -r '.[] | select(startswith("/") | not)
      | select(test("Home Manager Apps|/Fonts/|/\\.keep$") | not)' \
  | while read -r t; do
      [[ -L "$HOME/$t" ]] && echo "  ✓ $t" || echo "  ✗ $t"
    done

echo "==> tools"
for t in nix mise uv gh kubectl nvim; do
  command -v "$t" >/dev/null && echo "  ✓ $t" || echo "  ✗ $t"
done

echo "==> identity"
if [[ ! -f "$HOME/.ssh/personal" ]]; then
  echo "  - skipped (no ~/.ssh/personal)"
  exit 0
fi
git whoami 2>/dev/null                                     && echo "  ✓ git active identity" || echo "  ✗ git active identity"
ssh -T git@personal 2>&1 | grep -q "successfully authenticated" && echo "  ✓ ssh personal"        || echo "  ✗ ssh personal"
ssh -T git@private  2>&1 | grep -q "successfully authenticated" && echo "  ✓ ssh private"         || echo "  ✗ ssh private"
