#!/usr/bin/env bash
set -euo pipefail

: "${DOTFILES:?set DOTFILES=/path/to/dotfiles}"
SRC="${DOTFILES}/config/wallpapers/source.jpg"
OUT="${DOTFILES}/config/wallpapers/wallpaper.jpg"

if [[ ! -f "${SRC}" ]]; then
  echo "error: missing source wallpaper: ${SRC}" >&2
  exit 1
fi

# -modulate is brightness,saturation,hue.
magick "${SRC}" -modulate 40,20,100 -fill "#1e1e3a" -colorize 50% -quality 90 "${OUT}"
echo "wrote ${OUT}"
