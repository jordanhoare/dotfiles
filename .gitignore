# Claude
.claude/settings.local.json
home/.claude/*
!home/.claude/settings.json
!home/.claude/CLAUDE.md
!home/.claude/skills/
!home/.claude/hooks/
!home/.claude/output-styles/

# SSH
home/.ssh/*
!home/.ssh/config

# Git
config/git/private

# macOS
.DS_Store

# Editor swap / backup files
*.swp
*.swo
*~

# AWS
home/.aws/credentials

# Gcloud - only properties is portable
config/gcloud/*
!config/gcloud/properties

# Azure
home/.azure/accessTokens.json
home/.azure/msal_token_cache.json
home/.azure/azureProfile.json
home/.azure/clouds.config

# Github / Gitlab - hosts files contain auth tokens
config/gh/hosts.yml
config/glab-cli/hosts.yml

# Kubernetes - cluster credentials
home/.kube/config

# Neovim - runtime data written into config dir
config/nvim/.repro
config/nvim/doc/tags

# Nix build artefact - produced by `make switch` on macOS
nix/result
