# %USERPROFILE%\.wslconfig - WSL host-level config, applies to all distros.
# Symlinked from %USERPROFILE%\.wslconfig to this file by win/bootstrap.ps1.
# After changes, restart WSL: 'wsl --shutdown' from Windows PowerShell.

[wsl2]
memory=12GB
processors=6
swap=4GB
swapfile=C:\\Users\\%USERNAME%\\AppData\\Local\\Temp\\swap.vhdx
pageReporting=false
nestedVirtualization=false
kernelCommandLine=sysctl.vm.max_map_count=262144
networkingMode=mirrored
dnsTunneling=true
firewall=true
vmIdleTimeout=60000

# Experimental features for better performance
[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
